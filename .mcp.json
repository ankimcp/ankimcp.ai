{
  "mcpServers": {
    "gsc": {
      "command": "/opt/homebrew/bin/uvx",
      "args": ["mcp-search-console"],
      "env": {
        "GSC_OAUTH_CLIENT_SECRETS_FILE": "${HOME}/.config/mcp-gsc/client_secrets.json"
      }
    },
    "claude-usage": {
      "command": "npx",
      "args": ["-y", "@anatoly314/claude-usage-mcp"]
    },
    "ankimcp-temp": {
      "type": "http",
      "url": "https://tunnel.ankimcp.ai/mcp"
    }
  }
}
